                 return false;
             sscanf(argv[i], "%d", &coe_soft_clause_weight);
         }
+        else if (0 == strcmp(argv[i], "-init"))
+        {
+            i++;
+            if (i >= argc)
+                return false;
+            if (!read_init_assignment(argv[i]))
+                exit(-1);
+        }
+    }
+    return true;
+}
+
+// Literals "v" (optional prefix) separated by blanks; lines starting with 'c' are skipped.
+// Variables not listed keep -1 and are drawn at random by init().
+bool ISDist::read_init_assignment(const char *filename)
+{
+    ifstream infile(filename);
+    if (!infile)
+    {
+        cout << "c the init file " << filename << " is invalid." << endl;
+        return false;
+    }
+    init_assignment.assign(num_vars + 1, -1);
+    int assigned = 0;
+    string line, tok;
+    while (getline(infile, line))
+    {
+        if (line.empty() || line[0] == 'c')
+            continue;
+        istringstream iss(line);
+        while (iss >> tok)
+        {
+            if (tok == "v")
+                continue;
+            int l = atoi(tok.c_str());
+            int v = abs(l);
+            if (v == 0 || v > num_vars)
+                continue;
+            if (init_assignment[v] == -1)
+                assigned++;
+            init_assignment[v] = (l > 0) ? 1 : 0;
+        }
     }
+    cout << "c init assignment: " << assigned << "/" << num_vars << " vars from " << filename << endl;
     return true;
 }
 
